# .env template - GESTAO COMPRAS
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/gestao_compras
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=gestao_compras

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=generate_a_strong_secret_key_here
DEBUG=True
CORS_ORIGINS=["http://localhost:3000"]

# AI Provider Control (Groq is primary, Gemini is optional/costly)
AI_PROVIDER=groq
ENABLE_GEMINI=false

# AI Keys
GROQ_API_KEY=your_groq_api_key
# Optional. Only required when ENABLE_GEMINI=true.
GEMINI_API_KEY=

# SEFAZ HTTP Settings
SEFAZ_REQUEST_TIMEOUT_SECONDS=10
SEFAZ_MAX_RETRIES=3
SEFAZ_BACKOFF_BASE_SECONDS=0.5

# App Settings
APP_NAME="Gestao de Compras V2"
APP_VERSION="2.0.0"
