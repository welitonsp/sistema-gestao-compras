# .env template - GESTAO COMPRAS
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/gestao_compras
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=gestao_compras

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=generate_a_strong_secret_key_here
DEBUG=True
CORS_ORIGINS=["http://localhost:3000"]

# AI Keys (Required for processing)
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# App Settings
APP_NAME="Gestao de Compras V2"
APP_VERSION="2.0.0"
